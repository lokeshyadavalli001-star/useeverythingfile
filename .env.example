# EVERYTHING FILE - Environment Configuration Template
# Server secrets must never be committed to git or exposed to the client bundle.
# Copy this file to .env for local deployment.

# Node environment
NODE_ENV=production

# Server Security
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# Optional conversion worker settings (defaults to isolated local process if available)
CONVERSION_WORKER_ENABLED=false
CONVERSION_TIMEOUT_MS=30000
MAX_UPLOAD_SIZE_MB=25
